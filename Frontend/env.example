# Frontend Environment Variables

# Google OAuth
VITE_GOOGLE_CLIENT_ID=68865718442-0na32flmllvguiilt67os6p6rvgl0eqi.apps.googleusercontent.com

# Backend API
VITE_API_BASE_URL=https://your-backend-url.com/api

# WebSocket
VITE_WS_URL=wss://your-backend-url.com

# Aptos Configuration
# Development: Sử dụng public node (có rate limits)
# Production: Sử dụng QuickNode hoặc Alchemy (không có rate limits)

# QuickNode Aptos API Key (Production)
# 1. Đăng ký tại: https://www.quicknode.com/
# 2. Tạo endpoint cho Aptos Mainnet
# 3. Copy endpoint URL và paste vào đây
VITE_APTOS_NODE_URL=https://responsive-weathered-hill.aptos-mainnet.quiknode.pro/b363dcabb59e76d6355f22f77644f3a924bce229

# Hoặc Alchemy Aptos API Key (Production)
# 1. Đăng ký tại: https://www.alchemy.com/
# 2. Tạo app cho Aptos Mainnet
# 3. Copy API key và paste vào đây
# VITE_APTOS_API_KEY=your_alchemy_api_key_here

# Aptos Connect API (Cho luồng login Aptos riêng)
# 1. Đăng ký tại: https://aptosconnect.app/
# 2. Tạo application và lấy client ID
# 3. Cấu hình redirect URI
VITE_APTOS_CONNECT_CLIENT_ID=your_aptos_connect_client_id_here
VITE_APTOS_CONNECT_REDIRECT_URI=https://your-domain.com

# Hướng dẫn đăng ký Aptos Connect:
# 1. Truy cập: https://aptosconnect.app/
# 2. Click "Get Started" hoặc "Sign Up"
# 3. Tạo tài khoản mới
# 4. Tạo application mới
# 5. Copy Client ID và paste vào VITE_APTOS_CONNECT_CLIENT_ID
# 6. Cấu hình Redirect URI: https://safeswap-frontend.onrender.com (production) hoặc http://localhost:5173 (development)

# Demo Mode (Development only)
VITE_DEMO_MODE=true 