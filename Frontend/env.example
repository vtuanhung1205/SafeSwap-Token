# Frontend Environment Variables

# Google OAuth
VITE_GOOGLE_CLIENT_ID=68865718442-0na32flmllvguiilt67os6p6rvgl0eqi.apps.googleusercontent.com

# Backend API
VITE_API_BASE_URL=https://safeswap-backend-service.onrender.com

# WebSocket
VITE_WS_URL=wss://your-backend-url.com

# Aptos Configuration
# Development: Sử dụng public node (có rate limits)
# Production: Sử dụng QuickNode hoặc Alchemy (không có rate limits)

# QuickNode Aptos API Key (Production)
# 1. Đăng ký tại: https://www.quicknode.com/
# 2. Tạo endpoint cho Aptos Mainnet
# 3. Copy endpoint URL và paste vào đây
VITE_APTOS_NODE_URL=https://responsive-weathered-hill.aptos-mainnet.quiknode.pro/b363dcabb59e76d6355f22f77644f3a924bce229

# Hoặc Alchemy Aptos API Key (Production)
# 1. Đăng ký tại: https://www.alchemy.com/
# 2. Tạo app cho Aptos Mainnet
# 3. Copy API key và paste vào đây
# VITE_APTOS_API_KEY=your_alchemy_api_key_here

# Demo Mode (Development only)
VITE_DEMO_MODE=true 