# Database Configuration
MONGODB_URI=mongodb://localhost:27017/safeswap
MONGODB_URI_PROD=mongodb+srv://username:password@cluster.mongodb.net/safeswap

# Server Configuration
PORT=5000
NODE_ENV=development
LOG_FORMAT=combined

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://safeswap-frontend.onrender.com,https://safeswap-token.vercel.app

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-super-secret-refresh-key-here
JWT_REFRESH_EXPIRES_IN=30d

# Session Configuration
SESSION_SECRET=your-super-secret-session-key-here
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_MAX_AGE=7*24*60*60*1000

# Aptos Configuration
APTOS_NETWORK=testnet
APTOS_NODE_URL=https://fullnode.testnet.aptoslabs.com/v1
APTOS_MAINNET_URL=https://fullnode.mainnet.aptoslabs.com/v1

# SafeSwap Configuration
SAFESWAP_CONTRACT_ADDRESS=0x1234567890123456789012345678901234567890123456789012345678901234
SAFESWAP_TOKEN_ADDRESS=0x1234567890123456789012345678901234567890123456789012345678901234::safeswap_coin::SafeSwapCoin

# Price Feed Configuration
COINGECKO_API_KEY=your-coingecko-api-key
COINGECKO_API_URL=https://api.coingecko.com/api/v3

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Security Configuration
BCRYPT_ROUNDS=12
PASSWORD_MIN_LENGTH=8
PASSWORD_MAX_LENGTH=128

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@safeswap.com

# Redis Configuration (for caching and sessions)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=your-redis-password

# Logging Configuration
LOG_LEVEL=info
LOG_FILE_PATH=./logs/app.log
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5

# Monitoring Configuration
ENABLE_METRICS=true
METRICS_PORT=9090

# WebSocket Configuration
WS_HEARTBEAT_INTERVAL=30000
WS_MAX_CONNECTIONS=1000

# Job Configuration
PRICE_UPDATE_INTERVAL=60000
LIQUIDITY_SYNC_INTERVAL=300000

# Production Configuration
ENABLE_HTTPS=false
SSL_CERT_PATH=
SSL_KEY_PATH=

# Backup Configuration
BACKUP_ENABLED=false
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=7

# Analytics Configuration
ANALYTICS_ENABLED=false
ANALYTICS_KEY=

# Feature Flags
ENABLE_SCAM_DETECTION=true
ENABLE_PRICE_ALERTS=false
ENABLE_LIQUIDITY_REWARDS=false
ENABLE_STAKING=false 